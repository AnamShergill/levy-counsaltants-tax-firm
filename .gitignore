# -----------------------------
# Node dependencies
# -----------------------------
node_modules/

# -----------------------------
# Environment variables
# -----------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example  # keep the template in Git

# -----------------------------
# Next.js build outputs
# -----------------------------
.next/
out/
dist/
build/

# Next.js cache
.next/cache/

# -----------------------------
# Logs
# -----------------------------
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# -----------------------------
# TypeScript
# -----------------------------
*.tsbuildinfo

# -----------------------------
# Coverage
# -----------------------------
coverage/

# -----------------------------
# Supabase / local database files
# -----------------------------
*.db
*.db-journal

# -----------------------------
# OS generated files
# -----------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
.directory
*.nib
*._DS_Store

# -----------------------------
# IDE / Editor folders
# -----------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------
# Runtime or temporary files
# -----------------------------
*.tmp
*.swp

# -----------------------------
# Public assets / uploads (optional)
# -----------------------------
public/uploads/

# -----------------------------
# Yarn / pnpm / lockfiles (optional if you want to ignore)
# -----------------------------
# yarn.lock
# pnpm-lock.yaml


# -----------------------------
# Supabase local configuration & keys
# -----------------------------
.supabase/
supabase/.temp/          # temporary files generated during dev
supabase/migrations/     # optional: ignore if you don’t want to commit local migrations
supabase/.config.toml    # local Supabase config (contains project refs)
supabase/.env            # local env files (do NOT commit service_role key)

# Optional: ignore generated SQL files if you don't want them in Git
supabase/**/*.sql
